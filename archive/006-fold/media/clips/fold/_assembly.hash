: 140.8}, {"gain": 0.45, "kind": "shimmer", "t": 144.4}, {"gain": 0.16, "kind": "tick", "t": 154.2}, {"gain": 0.16, "kind": "tick", "t": 154.3}, {"gain": 0.16, "kind": "tick", "t": 154.4}, {"gain": 0.16, "kind": "tick", "t": 154.5}, {"gain": 0.16, "kind": "tick", "t": 154.6}, {"gain": 0.16, "kind": "tick", "t": 154.7}, {"gain": 0.16, "kind": "tick", "t": 154.8}, {"gain": 0.16, "kind": "tick", "t": 154.9}, {"gain": 0.16, "kind": "tick", "t": 155.0}, {"gain": 0.16, "kind": "tick", "t": 155.1}, {"gain": 0.16, "kind": "tick", "t": 155.2}, {"gain": 0.16, "kind": "tick", "t": 155.3}, {"gain": 0.5, "kind": "riser", "t": 160.4}, {"gain": 0.45, "kind": "chime", "t": 167.6}, {"gain": 0.45, "kind": "impact", "t": 174.4}], "sfx_db": -4}|25131e86e061f44a|[Script Info]
