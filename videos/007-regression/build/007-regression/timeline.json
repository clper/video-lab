  "cues": [
    {
      "start": 0.347,
      "end": 1.68,
      "text": "一位飞行教官"
    },
    {
      "start": 1.68,
      "end": 3.088,
      "text": "站起来反驳了他"
    },
    {
      "start": 4.307,
      "end": 6.258,
      "text": "他表扬飞得漂亮的学员"
    },
    {
      "start": 7.507,
      "end": 8.592,
      "text": "下一次"
    },
    {
      "start": 8.592,
      "end": 9.906,
      "text": "那个人飞得更差"
    },
    {
      "start": 11.131,
      "end": 12.558,
      "text": "他骂飞得糟糕的"
    },
    {
      "start": 12.558,
      "end": 13.601,
      "text": "下次更好"
    },
    {
      "start": 14.827,
      "end": 15.853,
      "text": "所以他说"
    },
    {
      "start": 15.853,
      "end": 16.926,
      "text": "表扬没用"
    },
    {
      "start": 16.926,
      "end": 17.993,
      "text": "骂才有用"
    },
    {
      "start": 19.219,
      "end": 20.486,
      "text": "他错在哪？"
    },
    {
      "start": 27.019,
      "end": 28.375,
      "text": "先玩一个东西"
    },
    {
      "start": 28.375,
      "end": 29.283,
      "text": "一块板"
    },
    {
      "start": 29.283,
      "end": 30.197,
      "text": "一堆钉子"
    },
    {
      "start": 31.435,
      "end": 33.558,
      "text": "一颗珠子从顶端落下"
    },
    {
      "start": 33.558,
      "end": 34.412,
      "text": "左或右"
    },
    {
      "start": 35.635,
      "end": 36.602,
      "text": "每一层"
    },
    {
      "start": 36.602,
      "end": 37.952,
      "text": "都是一次抛硬币"
    },
    {
      "start": 42.587,
      "end": 43.707,
      "text": "几千颗之后"
    },
    {
      "start": 43.707,
      "end": 44.974,
      "text": "堆出这条曲线"
    },
    {
      "start": 46.211,
      "end": 47.32,
      "text": "中间最多"
    },
    {
      "start": 47.32,
      "end": 48.54,
      "text": "两头最少"
    },
    {
      "start": 49.763,
      "end": 51.166,
      "text": "极端不是本事"
    },
    {
      "start": 51.166,
      "end": 52.068,
      "text": "是运气"
    },
    {
      "start": 53.291,
      "end": 54.47,
      "text": "1886 年"
    },
    {
      "start": 54.47,
      "end": 56.056,
      "text": "高尔顿也画了这条线"
    },
    {
      "start": 57.275,
      "end": 59.698,
      "text": "他量了 928 个成年子女的身高"
    },
    {
      "start": 63.923,
      "end": 65.22,
      "text": "高个父母的孩子"
    },
    {
      "start": 65.22,
      "end": 66.381,
      "text": "平均更矮"
    },
    {
      "start": 67.595,
      "end": 68.881,
      "text": "矮个父母的孩子"
    },
    {
      "start": 68.881,
      "end": 70.041,
      "text": "平均更高"
    },
    {
      "start": 71.267,
      "end": 72.541,
      "text": "偏离的那部分"
    },
    {
      "start": 72.541,
      "end": 73.985,
      "text": "只回来三分之二"
    },
    {
      "start": 75.227,
      "end": 77.303,
      "text": "他给这件事起了个名字"
    },
    {
      "start": 77.303,
      "end": 78.157,
      "text": "回归"
    },
    {
      "start": 82.379,
      "end": 83.476,
      "text": "不是退步"
    },
    {
      "start": 83.476,
      "end": 85.097,
      "text": "是回到自己的那条线"
    },
    {
      "start": 86.779,
      "end": 88.112,
      "text": "那次飞得漂亮"
    },
    {
      "start": 88.112,
      "end": 89.449,
      "text": "是超常发挥"
    },
    {
      "start": 90.691,
      "end": 92.413,
      "text": "下次就算什么都不做"
    },
    {
      "start": 92.413,
      "end": 93.361,
      "text": "也会下来"
    },
    {
      "start": 94.579,
      "end": 96.124,
      "text": "那次摔得难看"
    },
    {
