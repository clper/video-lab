{
  "id": "005-emergence",
  "title": "涌现",
  "voice": "zh-CN-YunxiNeural",
  "rate": "+8%",
  "scenes": [
    {
      "id": "S1",
      "narration": "鸟群没有指挥，为什么从不相撞？"
    },
    {
      "id": "S2",
      "narration": "没有会议，没有领导，只有三条规则。"
    },
    {
      "id": "S3",
      "narration": "一只猛禽斜穿过来，鸟群瞬间撕开。"
    },
    {
      "id": "S4",
      "narration": "每一只，都只看着身边的七只。"
    },
    {
      "id": "S5",
      "narration": "黏菌没有大脑，却能画出最优路线。"
    },
    {
      "id": "S6",
      "narration": "同一张网，被工程师抄成了地铁图。"
    },
    {
      "id": "S7",
      "narration": "五个细胞，能演化出会飞的滑翔机。"
    },
    {
      "id": "S8",
      "narration": "第五十六代，它自己走了出来。"
    },
    {
      "id": "S9",
      "narration": "一个机制，撑住了四个尺度。"
    },
    {
      "id": "S10",
      "narration": "你的大脑，也是这样亮起来的。"
    },
    {
      "id": "S11",
      "narration": "同一套规则，也能让群体瞬间崩散。"
    },
    {
      "id": "S12",
      "narration": "越过临界点，崩塌只用了一瞬间。"
    },
    {
      "id": "S13",
      "narration": "以为它们只是各自在飞，错了。"
    },
    {
      "id": "S14",
      "narration": "涌现：整体有了，个体却没有。"
    },
    {
      "id": "S15",
      "narration": "你无法从一只鸟，读出整个鸟群。"
    }
  ],
  "aspect": "portrait",
  "end_hold": 0.9
}